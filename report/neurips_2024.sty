%%
%% neurips_2024.sty  —  NeurIPS 2024 Style Approximation
%%
%% This file approximates NeurIPS 2024 formatting for LOCAL compilation.
%% For final Overleaf submission, use the official NeurIPS 2024 template:
%%   https://www.overleaf.com/latex/templates/neurips-2024
%% and replace this file with the official neurips_2024.sty from that template.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/05/08 NeurIPS 2024 Approximation]

\ProcessOptions\relax

%% -----------------------------------------------------------------------
%% Page geometry  (single-column locally; Overleaf template adds 2-column)
%% -----------------------------------------------------------------------
\usepackage[
  paperwidth  = 8.5in,
  paperheight = 11in,
  left        = 1.0in,
  right       = 1.0in,
  top         = 1.0in,
  bottom      = 1.0in,
  columnsep   = 0.25in,
  headheight  = 14pt,
  headsep     = 0.2in
]{geometry}

%% -----------------------------------------------------------------------
%% Fonts  (Times Roman — matches NeurIPS)
%% -----------------------------------------------------------------------
\usepackage{mathptmx}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{microtype}

%% -----------------------------------------------------------------------
%% Mathematics
%% -----------------------------------------------------------------------
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{amsfonts}
\usepackage{bm}

%% -----------------------------------------------------------------------
%% Graphics & colour
%% -----------------------------------------------------------------------
\usepackage{graphicx}
\usepackage{xcolor}

%% -----------------------------------------------------------------------
%% Tables
%% -----------------------------------------------------------------------
\usepackage{booktabs}
\usepackage{multirow}
\usepackage{array}
\usepackage{tabularx}
\usepackage{adjustbox}

%% -----------------------------------------------------------------------
%% Algorithms
%% -----------------------------------------------------------------------
\usepackage{algorithm}
\usepackage{algorithmic}
\renewcommand{\algorithmicrequire}{\textbf{Require:}}
\renewcommand{\algorithmicensure}{\textbf{Output:}}

%% -----------------------------------------------------------------------
%% URLs
%% -----------------------------------------------------------------------
\usepackage{url}
\urlstyle{tt}

%% -----------------------------------------------------------------------
%% Hyperlinks  (load near-last to avoid conflicts)
%% -----------------------------------------------------------------------
\usepackage[
  colorlinks = true,
  citecolor  = blue!75!black,
  linkcolor  = blue!75!black,
  urlcolor   = blue!75!black,
  bookmarks  = true
]{hyperref}

%% -----------------------------------------------------------------------
%% Captions
%% -----------------------------------------------------------------------
\usepackage[
  font        = small,
  labelfont   = bf,
  labelsep    = period,
  justification = raggedright,
  singlelinecheck = false
]{caption}

%% -----------------------------------------------------------------------
%% Bibliography  (numbered, compressed)
%% -----------------------------------------------------------------------
\usepackage[numbers, compress, sort]{natbib}

%% -----------------------------------------------------------------------
%% Section formatting
%% -----------------------------------------------------------------------
\usepackage{titlesec}
\titleformat{\section}
  {\normalfont\large\bfseries}{\thesection.}{0.5em}{}
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\itshape}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}   {0pt}{11pt plus 2pt minus 2pt}{5pt plus 1pt}
\titlespacing*{\subsection}{0pt}{ 8pt plus 2pt minus 2pt}{3pt}
\titlespacing*{\subsubsection}{0pt}{6pt plus 1pt}{2pt}

%% -----------------------------------------------------------------------
%% Paragraph spacing
%% -----------------------------------------------------------------------
\setlength{\parindent}{0.15in}
\setlength{\parskip}{3pt}

%% -----------------------------------------------------------------------
%% Abstract environment
%% -----------------------------------------------------------------------
\renewenvironment{abstract}{%
  \begin{center}
    {\large\bfseries Abstract}
  \end{center}
  \begin{quote}\small\noindent
}{%
  \end{quote}\vspace{1ex}
}

%% -----------------------------------------------------------------------
%% Float parameters
%% -----------------------------------------------------------------------
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.7}
